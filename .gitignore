# Binary
/target
**/*.rs.bk
**/target/

# Stray compiled artifacts
/gen_keys

# IDE
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.sdkt.toml.local
*.local

# Default `sdkt fuzz` output dir (written to the cwd, e.g. by CLI tests)
sdkt-fuzz-artifacts/

# Runtime dependency cache (sdkt package fetch/update) — never commit
.sdkt-cache/
**/.sdkt-cache/

# Cargo registry cache (optional, speeds up CI)
# NOTE: Cargo.lock is intentionally tracked (not ignored) — the CI Action
# installs with `cargo install --locked`, which requires it in the tree.
.project/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
